{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["npm"],
  "includePaths": ["crates/wallets/src/wallet_browser/app/src/**"],
  "ignoreDeps": ["pnpm"],
  "timezone": "UTC",
  "schedule": ["* 9-12 * * 1"],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "dependencyDashboard": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": ["dependencies", "javascript"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": [
        "crates/wallets/src/wallet_browser/app/src/package.json"
      ],
      "groupName": "browser wallet dependencies",
      "groupSlug": "browser-wallet",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "env CI=true pnpm install --frozen-lockfile --ignore-scripts",
      "env CI=true pnpm run build"
    ],
    "workingDirTemplate": "{{{packageFileDir}}}",
    "fileFilters": [
      "crates/wallets/src/wallet_browser/app/assets/**"
    ],
    "executionMode": "branch",
    "installTools": {
      "node": {},
      "pnpm": {}
    }
  }
}
